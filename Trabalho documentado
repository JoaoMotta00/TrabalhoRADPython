################################################################################################################

import sqlite3 #Importa biblioteca do banco de dados SQLite3

#EXECUTAR PRIMEIRO

try:
#Cria o banco de dados
    connection = sqlite3.connect("alunos.db") #Cria um arquivo .db para armazenar os dados
    alunos = connection.cursor() #Cria cursor pra executar comandos SQL no banco de dados

    #Cria a tabela alunos, caso ela não exista, com os campos matrícula, cpf, nome, data_nascimento e endereço.
    alunos.execute("""
        CREATE TABLE IF NOT EXISTS alunos(matricula INTEGER,
                                        cpf INTEGER,
                                        nome TEXT NOT NULL,
                                        data_nascimento TEXT NOT NULL,
                                        endereco TEXT NOT NULL,
                                        PRIMARY KEY(matricula, cpf))
    """) #PRIMARY KEY: chave primária. Composta por matrícula e cpf nesse caso, garantindo que cada aluno seja único no banco de dados.
    #INTEGER: números inteiros
    #TEXT NOT NULL: campo obrigatório, não pode ser nulo

    connection.commit() #Salva as alterações feitas no banco de dados
    
#Tratamento de exceção para erros relacionados ao banco de dados SQLite3. 
except sqlite3.Error as erro:
    print(f"Erro ao conectar/criar banco de dados: {erro}")


################################################################################################################


#Outras operações da tabela INSERT, DELETE, UPDATE, SELECT

opcao = 0 #Variável para armazenar a opção escolhida pelo usuário no menu de operações. 

#O programa entra em um loop que exibe um menu de opções para o usuário. 
# O loop continua até que o usuário escolha a opção 5 para encerrar o programa.
while opcao != 5 :
    try:
        #Exibe o menu de opções para o usuário
        print("------------------------------")
        print("1 - INSERIR DADO NA TABELA")
        print("2 - ATUALIZAR DADO NA TABELA")
        print("3 - DELETAR DADO NA TABELA")
        print("4 - EXIBIR DADOS DA TABELA")
        print("5 - ENCERRAR O PROGRAMA")
        print("------------------------------")
        opcao = int(input("SELECIONE UMA OPÇÃO: ")) #Lê a opção escolhida pelo usuário e converte para inteiro.
        
        #INSERT
        if opcao == 1:
            try:
                matricula = int(input("DIGITE A MATRICULA DO ALUNO: "))
                cpf = int(input("DIGITE O CPF DO ALUNO: "))
                nome = input("DIGITE O NOME DO ALUNO: ")
                data = input("DIGITE A DATA DE NASCIMENTO DO ALUNO: ")
                endereco = input("DIGITE O ENDEREÇO DO ALUNO: ")
                
                alunos.execute("INSERT INTO alunos(matricula, cpf, nome, data_nascimento, endereco) VALUES(?, ?, ?, ?, ?)", 
                            (matricula,
                            cpf,
                            nome,
                            data,
                            endereco))
                
                connection.commit()
                print("Aluno cadastrado com sucesso!")
            
            except ValueError:
                print("Erro: matrícula e CPF devem ser números inteiros.")

        
        #UPDATE
        elif opcao == 2:
            try:
                seletorAluno = int(input("DIGITE A MATRICULA DO ALUNO PARA EDITAR: "))
                print("1 - NOME")
                print("2 - ENDEREÇO")
                seletor = int(input("SELECIONE O QUE QUER EDITAR "))

                if seletor == 1:
                    nome = input("DIGITE O NOVO NOME: ")
                    alunos.execute("UPDATE alunos SET nome = ? WHERE matricula = ?", (nome, seletorAluno))

                    connection.commit()
                    print("Nome atualizado com sucesso!")

                elif seletor == 2:
                    endereco = input("DIGITE O NOVO ENDEREÇO: ")
                    alunos.execute("UPDATE alunos SET endereco = ? WHERE matricula = ?", (endereco, seletorAluno))

                    connection.commit()
                    print("Endereço atualizado com sucesso!")
            
            except ValueError:
                print("Erro: matrícula deve ser um número inteiro.")
        
        #DELETE
        elif opcao == 3:
            try:
                matricula = int(input("DIGITE A MATRÍCULA QUE DESEJA APAGAR: "))

                alunos.execute("DELETE FROM alunos WHERE matricula = ?", (matricula,))

                connection.commit()
                print("Aluno deletado com sucesso!")
            
            except ValueError:
                print("Erro: matrícula deve ser um número inteiro.")

        #SELECT
        elif opcao == 4:
            for i in alunos.execute("SELECT rowid, * FROM alunos ORDER BY nome"):
                print(i)


    except ValueError:
        print("Erro: digite apenas números no menu.")

connection.close() #Fecha a conexão com o banco de dados quando o programa é encerrado.


